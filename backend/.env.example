# Copy this file to .env only when an override is needed.
# The defaults already bind the development server to loopback.
OPSBRIDGE_ENVIRONMENT=development
OPSBRIDGE_HOST=127.0.0.1
OPSBRIDGE_PORT=8000
OPSBRIDGE_DEBUG=false
OPSBRIDGE_LOG_LEVEL=INFO

# SQLite is the supported local database for v1.0.0-rc.1.
# Relative paths are resolved from the directory where the server starts.
OPSBRIDGE_DATABASE_URL=sqlite+pysqlite:///./var/opsbridge.db

# One exact credentialed browser origin; wildcards are rejected.
OPSBRIDGE_FRONTEND_ORIGIN=http://127.0.0.1:5173
# False is allowed only for the loopback HTTP development profile.
OPSBRIDGE_SESSION_COOKIE_SECURE=false
OPSBRIDGE_SESSION_ABSOLUTE_MINUTES=480
OPSBRIDGE_SESSION_IDLE_MINUTES=30

